{
  "name": "grove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Grove-compatible board recreations built with tscircuit TSX",
  "keywords": [
    "tscircuit",
    "grove",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build --concurrency 1 --autorouter-timeout 10s",
    "snapshot:generate": "tsci snapshot --update --force-update --concurrency 1",
    "snapshot:normalize": "bun scripts/normalize-snapshots.ts && bun scripts/normalize-snapshots.ts",
    "snapshot:check": "bun scripts/check-snapshots.ts",
    "bom:check": "bun scripts/check-bom.ts",
    "snapshot": "bun run snapshot:generate && bun run snapshot:normalize && bun run snapshot:check && bun run bom:check",
    "snapshot:update": "bun run snapshot:generate && bun run snapshot:normalize",
    "catalogue:generate": "bun scripts/generate-grove-catalogue.ts",
    "validate:catalogue": "bun scripts/validate-catalogue.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build && bun run snapshot"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "fast-xml-parser": "^5.10.1",
    "tscircuit": "^0.0.2341",
    "typescript": "^5.0.0"
  }
}
